{
    "name": "tofu-movies",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint pages components server utils",
        "format": "prettier . --w",
        "postinstall": "prisma generate",
        "typecheck": "tsc --noEmit",
        "test": "jest --runInBand",
        "local:setup": "python3 scripts/setup-local.py",
        "build:portfolio": "next build portfolio-site --webpack",
        "test:portfolio": "playwright test --config=playwright.portfolio.config.ts",
        "test:local": "node scripts/verify-local-api.mjs",
        "deploy:portfolio": "yarn build:portfolio && yarn test:portfolio && python3 scripts/deploy_portfolio.py"
    },
    "dependencies": {
        "@emotion/react": "^11.10.0",
