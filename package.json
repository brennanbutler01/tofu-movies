        "react-dom": "18.3.1",
        "react-icons": "^4.4.0",
        "react-world-flags": "^1.5.1",
        "superjson": "^1.9.1",
        "swr": "^1.3.0",
        "uuid": "11.1.1",
        "zod": "3.25.76",
        "sanitize-html": "2.17.7",
        "@prisma/adapter-pg": "7.10.0"
    },
    "devDependencies": {
        "@playwright/test": "1.58.2",
        "@types/formidable": "3.4.5",
