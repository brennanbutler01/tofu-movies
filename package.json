        "@mantine/form": "^5.1.6",
        "@mantine/hooks": "^5.2.3",
        "@mantine/modals": "^5.2.3",
        "@mantine/next": "5.1.0",
        "@mantine/notifications": "^5.1.6",
        "@mantine/nprogress": "^5.2.3",
        "@next-auth/prisma-adapter": "^1.0.4",
        "@prisma/client": "7.10.0",
        "axios": "1.20.0",
        "cloudinary": "2.11.0",
        "cookies-next": "6.1.1",
        "country-to-iso": "^1.3.0",
        "dayjs": "^1.11.5",
        "embla-carousel-react": "^7.0.1",
        "formidable": "3.5.4",
